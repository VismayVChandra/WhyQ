# Supabase — get these from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is used server-side only (API routes), never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Quick-commerce data provider API key (server-side only).
# The app runs fully on mock data until this is set — see lib/providers/README.md.
QUICKCOMMERCE_API_KEY=
